<?xml version="1.0" encoding="utf-8"?>
<!-- Native splash is the static mark on the dark ground, so there's no
     flash before the count-in (design: motion.splashCountIn). -->
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:drawable="@color/tempo_bg" />
    <item android:drawable="@drawable/tempo_mark" android:gravity="center" android:width="72dp" android:height="72dp" />
</layer-list>
