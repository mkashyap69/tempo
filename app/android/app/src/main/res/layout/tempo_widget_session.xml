<?xml version="1.0" encoding="utf-8"?>
<!-- Tempo Coach session widget: today's session, its status, Start. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:orientation="vertical"
    android:padding="16dp">
    <TextView android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Today" android:textAllCaps="true" android:letterSpacing="0.09" android:textSize="10sp" android:textStyle="bold" android:textColor="@color/widget_text3" />
    <TextView android:id="@+id/session_title" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:maxLines="1" android:ellipsize="end" android:textSize="18sp" android:textColor="@color/widget_text1" android:text="Open Tempo" />
    <TextView android:id="@+id/session_detail" android:layout_width="match_parent" android:layout_height="wrap_content" android:maxLines="1" android:ellipsize="end" android:textSize="12sp" android:textColor="@color/widget_text2" />
    <TextView android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1" />
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical" android:orientation="horizontal">
        <TextView android:id="@+id/session_status" android:layout_width="0dp" android:layout_height="wrap_content" android:layout_weight="1" android:maxLines="1" android:ellipsize="end" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_text2" />
        <TextView android:id="@+id/session_start" android:layout_width="wrap_content" android:layout_height="32dp" android:gravity="center" android:paddingStart="16dp" android:paddingEnd="16dp" android:background="@drawable/widget_button" android:text="Start" android:textSize="13sp" android:textStyle="bold" android:textColor="@color/widget_button_text" />
    </LinearLayout>
</LinearLayout>
